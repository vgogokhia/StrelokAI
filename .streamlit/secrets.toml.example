# Copy this file to .streamlit/secrets.toml and fill in what you use.
# EVERY section is optional: without secrets the calculator runs fully,
# only accounts/profiles, Google login and scope-photo recognition are off.
# DO NOT commit secrets.toml to git!

# --- Accounts & saved profiles (Firestore) ---------------------------------
# Paste the fields of a GCP service-account JSON key here.
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@your-project.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
# database_id = "strelokai"   # optional, defaults to "strelokai"

# --- "Stay logged in" cookie signing ---------------------------------------
# Without this, logins survive reconnects but not a server restart.
# [auth]
# cookie_secret = "a-long-random-string"

# --- Google sign-in ---------------------------------------------------------
# [google]
# client_id = "your-google-client-id.apps.googleusercontent.com"
# client_secret = "your-google-client-secret"
# redirect_uri = "https://strelokai.streamlit.app"

# --- Scope photo recognition (Gemini) ---------------------------------------
# GEMINI_API_KEY = "your-key"
